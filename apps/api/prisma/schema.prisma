// mandatoryMinimum 세팅·변경 이력 (ADR 0022)
enum MinimumEvidenceType {
  CONTRACT // 계약서 근거 — evidenceUrl 필수
  LEGAL // 법령 근거 — evidenceUrl 필수
  FIXED_COST // 계약 없는 고정비 (임대료 등) — evidenceUrl optional
}

enum MinimumChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED // 같은 categoryPlanId 새 PENDING 등장 시 이전 자동 취소 (grill Q5)
}

model MandatoryMinimumChangeLog {
  id             Int                 @id @default(autoincrement())
  categoryPlanId Int
