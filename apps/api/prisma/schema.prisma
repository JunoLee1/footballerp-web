model Contract {
  id                      String         @id @default(cuid())
  startDate               DateTime
  endDate                 DateTime
  salary                  Int
  signingBonus            BigInt         @default(0)
  signingBonusScheduledAt DateTime?
  signingBonusPaidAt      DateTime?
  status                  ContractStatus @default(ACTIVE)
  contractType            ContractType   @default(PROFESSIONAL)
  playerId                String
  managedById             String?
  agencyId                Int?
  agencyCommission        Decimal?       @db.Decimal(12, 2)

  player             Player             @relation(fields: [playerId], references: [id])
  managedBy          User?              @relation(fields: [managedById], references: [id])
  agency             Agency?            @relation(fields: [agencyId], references: [id])
  buyoutClause       BuyoutClause?
  extensionOptions   ExtensionOption[]
  performanceBonuses PerformanceBonus[]
}

model BuyoutClause {
  id         Int       @id @default(autoincrement())
  amount     BigInt
  validUntil DateTime?
  contractId String    @unique

  contract Contract @relation(fields: [contractId], references: [id])
}

model ExtensionOption {
  id             Int     @id @default(autoincrement())
  condition      String
  durationMonths Int
  conditionText  String?
  minAppearances Int?
  contractId     String

  contract Contract @relation(fields: [contractId], references: [id])
}

model PerformanceBonus {
  id          Int    @id @default(autoincrement())
  amount      BigInt
  description String
  contractId  String

  contract    Contract       @relation(fields: [contractId], references: [id])
  triggers    BonusTrigger[]
  triggeredAt DateTime?
  executedAt  DateTime?
}

model BonusTrigger {
  id              Int              @id @default(autoincrement())
  metric          BonusMetric
  threshold       Float
  period          BonusPeriod
  competitionType CompetitionType?
  teamScope       BonusTeamScope   @default(ALL)
  bonusId         Int

  bonus PerformanceBonus @relation(fields: [bonusId], references: [id])
}

model Transfer {
  id        Int          @id @default(autoincrement())
  type      TransferType
  date      DateTime
  startDate DateTime?
  endDate   DateTime?
  fee       Int?
  fromClub  String?
  toClub    String?
  playerId  String

  player Player  @relation(fields: [playerId], references: [id])
  recall Recall?
}

model Recall {
  id            Int          @id @default(autoincrement())
  status        RecallStatus @default(PENDING)
  requestedAt   DateTime     @default(now())
  approvedAt    DateTime?
  transferId    Int          @unique
  requestedById String
  approvedById  String?

  transfer    Transfer @relation(fields: [transferId], references: [id])
  requestedBy User     @relation("RecallRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?    @relation("RecallApprovedBy", fields: [approvedById], references: [id])
}

model TransferRequest {
  id           Int                   @id @default(autoincrement())
  status       TransferRequestStatus @default(DRAFT)
  type         TransferType
  playerId     String
  agencyId     Int
  fromClub     String?
  toClub       String?
  fee          Int?
  startDate    DateTime?
  endDate      DateTime?
  rejectReason String?

  expectedSalary Int?
  medicalNotes   String?
  registeredAt   DateTime?

  requestedById String
  reviewedById  String?
  confirmedById String?
  rejectedById  String?

  reviewedAt  DateTime?
  confirmedAt DateTime?
  rejectedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  player          Player                   @relation(fields: [playerId], references: [id])
  agency          Agency                   @relation(fields: [agencyId], references: [id])
  requestedBy     User                     @relation("TRRequestedBy", fields: [requestedById], references: [id])
  reviewedBy      User?                    @relation("TRReviewedBy", fields: [reviewedById], references: [id])
  confirmedBy     User?                    @relation("TRConfirmedBy", fields: [confirmedById], references: [id])
  rejectedBy      User?                    @relation("TRRejectedBy", fields: [rejectedById], references: [id])
