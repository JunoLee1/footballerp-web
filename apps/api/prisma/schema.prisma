model AssetRequest {
  id           Int                @id @default(autoincrement())
  requesterId  String
  departmentId Int
  type         AssetRequestType
  status       AssetRequestStatus @default(DRAFT)

  // hybrid payload — one of equipmentItemId/softwareLicenseId/customName required
  equipmentItemId   Int?
  softwareLicenseId Int?
  customName        String?
  customDescription String?

  expenseCategoryId Int
  expectedAmount    Int
  neededBy          DateTime?
  justification     String

  operatingExpenseId Int?

  // #373 자동 프로비저닝 추적: dispatch() 성공 후 부서 default kit 로부터 자동 생성된 draft
  // 여부와 어떤 dispatch 로부터 왔는지 감사용 링크. FE 에서 "자동 프로비저닝" 배지 + 링크 제공.
  isAutoProvisioned         Boolean @default(false)
  provisionedFromDispatchId Int?

  clubId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester               User                   @relation("AssetRequestRequester", fields: [requesterId], references: [id])
  department              Department             @relation(fields: [departmentId], references: [id])
  expenseCategory         ExpenseCategory        @relation(fields: [expenseCategoryId], references: [id])
  equipmentItem           EquipmentItem?         @relation(fields: [equipmentItemId], references: [id])
  softwareLicense         SoftwareLicense?       @relation(fields: [softwareLicenseId], references: [id])
  operatingExpense        OperatingExpense?      @relation(fields: [operatingExpenseId], references: [id])
  provisionedFromDispatch HiringDispatch?        @relation("DispatchProvisioned", fields: [provisionedFromDispatchId], references: [id], onDelete: SetNull)
  club                    Club?                  @relation("AssetRequestClub", fields: [clubId], references: [id])
  approvals               AssetRequestApproval[]

  @@index([requesterId, status])
  @@index([departmentId, status])
  @@index([status, createdAt])
  @@index([clubId, status])
  @@index([provisionedFromDispatchId])
}

