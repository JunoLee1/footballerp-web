  improvementAnalyses    TacticalAnalysis[]        @relation("ImprovementPlayer")
  videoAssignments       VideoAssignment[]
  callups                PlayerCallup[]
  workPermitAlerts       WorkPermitAlertLog[]
  playStyle              PlayStyle?
  allergies              String[]
  foodPreferences        String?
  // 최신값 캐시 — MarketValueHistory 항목 생성 시 항상 동시 업데이트할 것 (service 레이어에서 트랜잭션 보장)
