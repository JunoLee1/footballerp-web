  startDate      DateTime
  endDate        DateTime
  sponsorshipFee Float?
  discountRate   Float?
  notes          String?
  responseHours  Int?
  resolutionDays Int?
  penaltyPerDay  Decimal?              @db.Decimal(12, 2)
