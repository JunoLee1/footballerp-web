// ─────────────────────────────────────────────
// 직무 온보딩 (OnboardingTemplate + OnboardingTask)
// ─────────────────────────────────────────────

/// Task 상태머신: PENDING → SELF_REPORTED → DONE / SKIPPED.
/// SELF_REPORTED 는 requiresVerification=true 인 task 의 중간 상태.
/// REJECT 는 SELF_REPORTED → PENDING 복귀 (별도 status 필드 없음, verifyNotes 로 표시).
enum OnboardingTaskStatus {
  PENDING
  SELF_REPORTED
  DONE
  SKIPPED
}

/// Department 1:1 온보딩 컨텐츠 템플릿 (DepartmentDefaultAssetKit 선례).
/// `tasks` = OnboardingTemplateTask[] JSON 배열. dispatch() 성공 시 스냅샷으로
/// OnboardingTask 로 populate 됨 (populate-onboarding-tasks.ts).
model OnboardingTemplate {
  id           Int      @id @default(autoincrement())
  departmentId Int      @unique
  name         String
  tasks        Json
  createdById  String
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("OnbTemplateCreator", fields: [createdById], references: [id])
  updatedBy  User?      @relation("OnbTemplateUpdater", fields: [updatedById], references: [id])
}

/// 신입 개인별 온보딩 태스크. dispatch() 안 template.tasks 스냅샷으로 자동 생성.
/// 상태전환: 본인 self-report → (verify 필요) HR/dept.head 검증 → DONE / PENDING 복귀.
model OnboardingTask {
  id                   Int                  @id @default(autoincrement())
  onboardingId         Int
  title                String
  description          String?
  dueDate              DateTime?
  requiresVerification Boolean              @default(false)
  optional             Boolean              @default(false)
  status               OnboardingTaskStatus @default(PENDING)
  order                Int                  @default(0)

  selfReportedAt DateTime?
  verifiedById   String?
  verifiedAt     DateTime?
  verifyNotes    String?
  skipReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboarding Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  verifiedBy User?      @relation("OnbTaskVerifier", fields: [verifiedById], references: [id])

  @@index([onboardingId, status])
  @@index([onboardingId, order])
}

