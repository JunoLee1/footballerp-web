  status             InjuryStatus  @default(OCCURRED)
  occurredAt         DateTime      @default(now())
  priorWeeklyLoad    Int?
  playerId           String
  medicalStaffId     String
  hospitalType       HospitalType?
  partnerId          Int?
  customHospitalName String?

  player                 Player            @relation(fields: [playerId], references: [id])
  medicalStaff           User              @relation(fields: [medicalStaffId], references: [id])
  partner                Partner?          @relation(fields: [partnerId], references: [id])
  medicalExpenses        MedicalExpense[]
  injuryReport           InjuryReport?
  assessment             InjuryAssessment?
  externalReports        ExternalReport[]
  incidentReports        IncidentReport[]
