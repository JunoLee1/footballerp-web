// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model Club {
  id                Int      @id @default(autoincrement())
  name              String
  isActive          Boolean  @default(true)
  isLite            Boolean  @default(false)
  countryId         Int?
  ownerEmail        String?  @unique
  businessRegNumber String?
  companyNumber     String?
  vatNumber         String?
  createdAt         DateTime @default(now())

  country           Country?           @relation(fields: [countryId], references: [id])
  teams             Team[]
  users             User[]
  leagues           ClubLeague[]
  departments       Department[]
  players           Player[]           @relation("PlayerClub")
  prospects         Prospect[]         @relation("ProspectClub")
  trainingSessions  TrainingSession[]  @relation("TrainingSessionClub")
  operatingExpenses OperatingExpense[] @relation("OperatingExpenseClub")
  equipmentItems    EquipmentItem[]    @relation("EquipmentItemClub")
  equipmentUnits    EquipmentUnit[]    @relation("EquipmentUnitClub")
  equipmentLoans    EquipmentLoan[]    @relation("EquipmentLoanClub")
  assetRequests     AssetRequest[]     @relation("AssetRequestClub")
}

model Team {
  id               Int      @id @default(autoincrement())
  name             String
  type             TeamType
  ageGroup         String?
  isActive         Boolean  @default(true)
  isLite           Boolean  @default(false)
  trackStats       Boolean  @default(true)
  requiresContract Boolean  @default(true)
  clubId           Int?
  createdAt        DateTime @default(now())

  club               Club?               @relation(fields: [clubId], references: [id])
  players            Player[]
  coachingStaff      User[]
  trainingSessions   TrainingSession[]
  matches            Match[]
  coaches            Coach[]
  callupsFrom        PlayerCallup[]      @relation("CallupFromTeam")
  callupsTo          PlayerCallup[]      @relation("CallupToTeam")
  jerseyNumbers      JerseyNumber[]
  youthRegistrations YouthRegistration[]
  incidentReports    IncidentReport[]
}

model Country {
  id   Int    @id @default(autoincrement())
  name String
  code String

  users     User[]
  players   Player[]
  clubs     Club[]
  leagues   League[]
  prospects Prospect[]
}

model PhoneNumber {
  id        Int     @id @default(autoincrement())
  iv        String
  encrypted String
  phoneHash String? @unique

  user User?
}

model User {
  id                String           @id @default(uuid())
  email             String           @unique
  password          String
  username          String
  nickname          String           @unique
  role              Role
  coachingRole      CoachingRole?
  frontOfficeRole   FrontOfficeRole?
  isDeleted         Boolean          @default(false)
  isOutOfOffice     Boolean          @default(false)
  isDemo            Boolean          @default(false)
  language          String           @default("ko")
  dateOfBirth       DateTime
  phoneNumberId     Int              @unique
  nationalityId     Int
  teamId            Int?
  clubId            Int?
  homeAddress       String?
  passwordChangedAt DateTime?

  phoneNumber                PhoneNumber                       @relation(fields: [phoneNumberId], references: [id])
  nationality                Country                           @relation(fields: [nationalityId], references: [id])
  player                     Player?
  recallRequests             Recall[]                          @relation("RecallRequestedBy")
  recallApprovals            Recall[]                          @relation("RecallApprovedBy")
  managedInjuries            Injury[]
  createdSessions            TrainingSession[]                 @relation("TrainingSessionCreatedBy")
  approvedSessions           TrainingSession[]                 @relation("TrainingSessionApprovedBy")
  tacticalAnalyses           TacticalAnalysis[]
  notifications              Notification[]
  managedContracts           Contract[]
  agentPlayers               Player[]                          @relation("AgentPlayers")
  createdProspects           Prospect[]                        @relation("ProspectCreatedBy")
  requestedLoans             EquipmentLoan[]                   @relation("LoanRequestedBy")
  approvedLoans              EquipmentLoan[]                   @relation("LoanApprovedBy")
  auditLogs                  AuditLog[]
  authoredReports            Report[]                          @relation("ReportAuthor")
  reviewedReports            Report[]                          @relation("ReportReviewer")
  firstReviewedReports       Report[]                          @relation("ReportFirstReviewer")
  secondReviewedReports      Report[]                          @relation("ReportSecondReviewer")
  submittedMedicalExpenses   MedicalExpense[]                  @relation("MedicalExpenseSubmitter")
  leaderReviewedExpenses     MedicalExpense[]                  @relation("MedicalExpenseLeaderReviewer")
  adminReviewedExpenses      MedicalExpense[]                  @relation("MedicalExpenseAdminReviewer")
  createdInjuryReports       InjuryReport[]                    @relation("InjuryReportCreator")
  updatedInjuryReports       InjuryReport[]                    @relation("InjuryReportUpdater")
  coachSignedReports         InjuryReport[]                    @relation("InjuryReportCoachSigner")
