  // 수습(probation) 트래킹. `probationStartedAt` 은 HiringDispatch.dispatch()
  // 실행 시점에 자동 세팅되고, `probationEndedAt` 은 SIX_MO PASSED 또는
  // 어느 시점의 FAILED review 가 커밋될 때 세팅된다.
  probationStartedAt DateTime?
  probationEndedAt   DateTime?
  probationStatus    ProbationStatus   @default(IN_PROGRESS)
  probationReviews   ProbationReview[]

  createdBy           User            @relation("StaffRecordCreator", fields: [createdById], references: [id])
  staffSalaries       StaffSalary[]
