  createdAt      DateTime                   @default(now())

  assetRequest AssetRequest @relation(fields: [assetRequestId], references: [id], onDelete: Cascade)
  reviewer     User         @relation("AssetRequestReviewer", fields: [reviewerId], references: [id])

  @@unique([assetRequestId, stage])
  @@index([assetRequestId, stage])
}

// ─────────────────────────────────────────────
// 부서별 기본 자산 세트 (#373 신입 자동 프로비저닝)
// ─────────────────────────────────────────────

/**
 * 부서마다 신입에게 자동 지급할 default 자산(노트북/사원증/유니폼 등) 리스트.
 * HiringDispatch.dispatch() 성공 후 fire-and-forget 훅이 이 모델을 조회해
 * 신입 계정으로 AssetRequest DRAFT 를 자동 생성함.
 * `assetItems` JSON shape: `[{ equipmentItemId: number, quantity: number, note?: string }]`
 * - equipmentItemId: EquipmentItem.id (하드웨어 마스터 참조; runtime 검증)
 * - quantity: 신입 1인당 몇 개
 * - note: draft justification 에 붙는 추가 설명 (옵션)
 * `defaultExpenseCategoryId`: 자동 생성 draft 의 expenseCategoryId 기본값
 * (신입이 편집 가능)
 * 재고 부족은 provisioning 단계에서 처리하지 않음(#373 grill Q1) — draft 는
 * 항상 생성되고 ASSET_MANAGER 에게만 부족 알림 발송. WAITING_STOCK 상태 도입은
 * 후속 이슈.
 */
model DepartmentDefaultAssetKit {
  id                       Int      @id @default(autoincrement())
  departmentId             Int      @unique
  assetItems               Json // [{equipmentItemId, quantity, note?}]
  defaultExpenseCategoryId Int
  createdById              String
  updatedById              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  department      Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  expenseCategory ExpenseCategory @relation(fields: [defaultExpenseCategoryId], references: [id])
  createdBy       User            @relation("DeptAssetKitCreator", fields: [createdById], references: [id])
  updatedBy       User?           @relation("DeptAssetKitUpdater", fields: [updatedById], references: [id])
}

// ─────────────────────────────────────────────
// 채용 파견 (HiringDispatch) - 4단계 후속 워크플로우
// ─────────────────────────────────────────────

enum HiringDispatchStatus {
  CREATED
  BUDGET_REVERIFIED
  DISPATCH_APPROVED
  DISPATCHED
  ONBOARDING
  COMPLETED
  REJECTED
  CANCELLED
}

enum HiringDispatchStage {
  BUDGET_REVIEW
  DISPATCH_APPROVAL
  EXECUTION
}

enum HiringDispatchAction {
  APPROVED
  REJECTED
}

enum HiringDocReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  ADVISOR
}

enum JobGrade {
  INTERN
  JUNIOR
  ASSOCIATE
  MANAGER
  DIRECTOR
  EXECUTIVE
}

model HiringDispatch {
  id                    Int                  @id @default(autoincrement())
  applicationId         Int?                 @unique
  candidateName         String
  candidateEmail        String
  jobTitle              String
  jobGrade              JobGrade
  employmentType        EmploymentType
  departmentId          Int
  reportsToUserId       String?
  monthlySalary         BigInt
  startDate             DateTime
  targetRole            Role
  targetFrontOfficeRole FrontOfficeRole?
  targetCoachingRole    CoachingRole?
  permissionNotes       String?
  status                HiringDispatchStatus @default(CREATED)
  createdUserId         String?              @unique
  createdById           String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  // Application-free path: required document types are declared directly on
  // the dispatch (Q10). When an applicationId is present, the JobPosting's
  // requiredDocuments is authoritative and this field is ignored by the gate.
  requiredDocuments     String[]             @default([])

  application              JobApplication?          @relation(fields: [applicationId], references: [id])
  department               Department               @relation(fields: [departmentId], references: [id])
  reportsToUser            User?                    @relation("DispatchReportsTo", fields: [reportsToUserId], references: [id])
  createdUser              User?                    @relation("DispatchCreatedUser", fields: [createdUserId], references: [id])
  createdBy                User                     @relation("DispatchCreator", fields: [createdById], references: [id])
  approvals                HiringDispatchApproval[]
  onboarding               Onboarding?
  documents                HiringDocument[]
  employeeContracts        EmployeeContract[]
  provisionedAssetRequests AssetRequest[]           @relation("DispatchProvisioned")

  @@index([status, createdAt])
  @@index([departmentId, status])
}

model HiringDispatchApproval {
  id         Int                  @id @default(autoincrement())
  dispatchId Int
  stage      HiringDispatchStage
  action     HiringDispatchAction
  reviewerId String
  reason     String?
  createdAt  DateTime             @default(now())

  dispatch HiringDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  reviewer User           @relation("DispatchReviewer", fields: [reviewerId], references: [id])

  @@unique([dispatchId, stage])
  @@index([dispatchId, stage])
}

/**
 * Documents collected as part of the hiring workflow. XOR reference — either
 * anchored to an in-flight JobApplication (candidate-pipeline docs) or to a
 * standalone HiringDispatch (Application-free 임원 스카웃 path). Re-uploads
 * are append-only: HR inserts a new row rather than mutating an existing one
 * (Contract 개정 선례), so `(target, docType)` history reads like an audit log
 * and the latest row wins. See `hiring-document.service.ts` for the
 * "current per docType" grouping and `hiring-dispatch.service.ts:dispatch()`
 * for the EXECUTION gate that requires every requiredDocument to have a
 * latest-row APPROVED status.
 */
model HiringDocument {
  id               Int                   @id @default(autoincrement())
  applicationId    Int?
  hiringDispatchId Int?
  docType          String
  fileUrl          String
  fileName         String?
  fileSize         Int?
  status           HiringDocReviewStatus @default(PENDING)
  uploadedById     String
  uploadedAt       DateTime              @default(now())
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNotes      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  application    JobApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  hiringDispatch HiringDispatch? @relation(fields: [hiringDispatchId], references: [id], onDelete: Cascade)
  uploadedBy     User            @relation("HiringDocUploader", fields: [uploadedById], references: [id])
  reviewedBy     User?           @relation("HiringDocReviewer", fields: [reviewedById], references: [id])

  @@index([applicationId, docType, createdAt(sort: Desc)])
  @@index([hiringDispatchId, docType, createdAt(sort: Desc)])
}

/**
 * 근로계약 스켈레톤 (#371). 파일 + 상태 + 서명 감사 필드만 관리.
 * `hiringDispatchId`는 @unique 아님 — 이력 append-only. 취소 후 재발행 시 새 row.
 * 상태머신: DRAFT → ISSUED → SIGNED / CANCELLED (역방향 없음).
 * HiringDispatch EXECUTION 게이트: 최신 non-CANCELLED EC 가 SIGNED 여야 통과.
 */
enum EmployeeContractStatus {
  DRAFT
  ISSUED
  SIGNED
  CANCELLED
}

model EmployeeContract {
  id               Int                    @id @default(autoincrement())
  hiringDispatchId Int
  status           EmployeeContractStatus @default(DRAFT)

  fileUrl        String?
  fileName       String?
  signedFileUrl  String?
  signedFileName String?

  createdById         String
  issuedById          String?
  issuedAt            DateTime?
  signedAt            DateTime?
  signedConfirmedById String?
  signedConfirmedAt   DateTime?
  cancelledById       String?
  cancelledAt         DateTime?
  cancelReason        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hiringDispatch    HiringDispatch @relation(fields: [hiringDispatchId], references: [id], onDelete: Cascade)
  createdBy         User           @relation("EmpContractCreator", fields: [createdById], references: [id])
  issuedBy          User?          @relation("EmpContractIssuer", fields: [issuedById], references: [id])
  signedConfirmedBy User?          @relation("EmpContractSigner", fields: [signedConfirmedById], references: [id])
  cancelledBy       User?          @relation("EmpContractCanceller", fields: [cancelledById], references: [id])

  @@index([hiringDispatchId, createdAt(sort: Desc)])
}

// ─── 선수 영입 수요조사 (#494) ─────────────────────────────────────────────────
model PlayerAcquisitionSurvey {
  id          Int          @id @default(autoincrement())
  title       String
  status      SurveyStatus @default(OPEN)
  dueDate     DateTime?
  notes       String?
  createdById String
  createdAt   DateTime     @default(now())
  closedAt    DateTime?

  createdBy User                              @relation("AcqSurveyCreator", fields: [createdById], references: [id])
  responses PlayerAcquisitionSurveyResponse[]

  @@index([status])
}

model PlayerAcquisitionSurveyResponse {
  id           Int       @id @default(autoincrement())
  surveyId     Int
  respondentId String
  submittedAt  DateTime?
  createdAt    DateTime  @default(now())

  survey     PlayerAcquisitionSurvey               @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  respondent User                                  @relation("AcqSurveyResponder", fields: [respondentId], references: [id])
  items      PlayerAcquisitionSurveyResponseItem[]

  @@unique([surveyId, respondentId])
  @@index([surveyId])
}

model PlayerAcquisitionSurveyResponseItem {
  id         Int            @id @default(autoincrement())
  responseId Int
  position   Position
  priority   SurveyPriority
  budgetMin  Int?
  budgetMax  Int?
  notes      String?

  response PlayerAcquisitionSurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
}
