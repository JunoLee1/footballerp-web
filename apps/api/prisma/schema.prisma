}

/// 신규 직원 팔로우업 (Probation follow-up). 부서장이 3개월/6개월 시점에
/// 평가를 제출한다. Cron `probationReviewNotifier` 가 D-7 알림을 부서장에게
/// 발송한다. FAIL 처리는 수동 — HR/부서장이 별도로 `StaffRecord.terminate` 호출.
model ProbationReview {
  id               Int                   @id @default(autoincrement())
  staffRecordId    Int
  reviewType       ProbationReviewType
  status           ProbationReviewStatus @default(PENDING)
  leaderAssessment String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  staffRecord StaffRecord @relation(fields: [staffRecordId], references: [id], onDelete: Cascade)
  reviewedBy  User?       @relation("ProbationReviewer", fields: [reviewedById], references: [id])

  @@unique([staffRecordId, reviewType])
  @@index([staffRecordId, status])
}

model FinancialReport {
  id                          Int                         @id @default(autoincrement())
  seasonId                    Int                         @unique
  totalRevenue                Float
  // Planned revenue breakdown (계획값). Actuals are always computed live from
  // source tables (SalesRecord, SponsorshipPayment, LedgerEntry). Do not write
  // actuals into these fields — that broke dashboards prior to 2026-08-22.
  plannedRevenueTicket        Float                       @default(0)
  plannedRevenueSponsorship   Float                       @default(0)
  // Expected sponsorship revenue (accrual basis): Σ SponsorshipPayment.amount
  // WHERE dueDate ∈ [season.startDate, season.endDate], status 무관.
  // Nullable for backward compatibility (see ADR 0024). plannedRevenueSponsorship
  // 은 여전히 Actual (cash by paidAt) — 이 필드가 추가되어도 breaking 없음.
  // Deviation from ADR (Int? → Float?): 실측 sponsorship 총합이 INT4 범위(2.1B)
  // 를 초과하는 시즌이 있어 sibling plannedRevenueSponsorship(Float) 와 동일한
  // double precision 으로 저장. FE 는 여전히 number 로 소비 가능.
  expectedRevenueSponsorship  Float?
  plannedRevenueBroadcast     Float                       @default(0)
  plannedRevenueMerchandise   Float                       @default(0)
  plannedRevenueSubsidy       Float                       @default(0)
  plannedRevenueParentCompany Float                       @default(0)
  plannedRevenueAcademyFee    Float                       @default(0)
  plannedRevenueOther         Float                       @default(0)
  totalOperatingBudget        Int?
  contingencyReserve          Int?                        @default(0)
  playerSalaryBudget          Int?
  note                        String?
  // 전년도 이월금 (auto-computed from prev season's approved MonthlySettlementReport
  // net income at closeSeason time, or manually overridden via
  // PATCH /financial-reports/:seasonId/carryover).
  carryOverFromPrev           Float                       @default(0)
  carryOverOverriddenById     String?
  carryOverOverriddenAt       DateTime?
  carryOverOverrideReason     String?
  // 편성 워크플로우 상태 머신 (spec 2026-08-29). FINALIZED 는 legacy 시즌 backfill.
  // BudgetPlanStatus 로 명명 (기존 PlanReport 의 PlanStatus enum 과 구분).
  planStatus                  BudgetPlanStatus            @default(FINALIZED)
  planStatusChangedAt         DateTime?
  planStatusChangedById       String?
  reviewOpenedAt              DateTime?
  reviewDeadline              DateTime?
  knapsackExecutedAt          DateTime?
  finalizedAt                 DateTime?
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  season                      Season                      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  carryOverOverriddenBy       User?                       @relation("CarryOverOverrider", fields: [carryOverOverriddenById], references: [id])
  planStatusChangedBy         User?                       @relation("PlanStatusChanger", fields: [planStatusChangedById], references: [id])
  budgetCategoryPlans         BudgetCategoryPlan[]
  overrideLogs                BudgetOverrideLog[]
  revenueLogs                 FinancialReportRevenueLog[]
  revenueAdjustments          RevenueAdjustment[]         @relation("SeasonAdj")
  planRequests                BudgetPlanRequest[]
}

