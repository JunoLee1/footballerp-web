{
  "name": "football-api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "predev": "prisma generate",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "prebuild": "prisma generate",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 tsc",
    "build:emit-only": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noCheck",
    "start": "node dist/server.js",
    "setup": "prisma db push && npm run seed",
    "test": "jest",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "generate": "prisma generate",
    "script:encrypt-pii": "tsx prisma/scripts/encrypt-pii.ts"
  },
  "prisma": {
    "seed": "npm run seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google-cloud/storage": "^7.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^10.74.0",
    "@types/nodemailer": "^8.0.1",
    "axios": "^1.18.1",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.29",
    "@types/node-cron": "^3.0.11",
    "@types/passport": "^1.0.17",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "^7.8.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
